rules_version = '2';

// =============================================================================
// ⚠️⚠️  v1.10.0 STAGED RULES — NOT YET DEPLOYED TO PRODUCTION  ⚠️⚠️
// -----------------------------------------------------------------------------
// This file is the v1.10.0 "Community Hub" TARGET (gate 1: the moderation spine).
// Production is STILL running the v1.9.x rules. These rules intentionally BREAK
// the current live client until the v1.10.0 cutover, because of the NEW global
// MODERATION GATE (gate 1):
//   • Every community write now requires a CF-written `moderationGate/{uid}`
//     {banned, consentVersion} doc: the writer must be NOT banned AND must have
//     consented to the community rules (consentVersion >= the rules-file literal
//     `rulesVersion()`). A user with no moderationGate doc (i.e. before the
//     gate-2 ban CFs + the consent flow exist) is DENIED every community write.
//   • Deploying this now would DENY all community writes (no one has consented).
// Therefore: DO NOT `firebase deploy --only firestore` (and never a bare
// `firebase deploy`) until the gate-2 ban CFs + the `acceptRules` consent flow
// are live and the client is cut over at the v1.10.0 cutover (same staged model
// v1.9.0 used). Emulator-green (`npm run test:rules`) is gate 1's finish line.
// Contract: docs/DATA-MODEL.md · study: docs/SHIP-OUTPUT.md.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    // ADMIN_UID — the existing hardcoded admin (status quo). M4: migrate to a
    // CF-set custom claim (request.auth.token.admin == true) in a later gate so
    // it rotates without a rules redeploy. Until then, the literal stands.
    function isAdmin() { return isSignedIn() && request.auth.uid == 'G2jGRa14u8bzGAmeBTkvXy8PKmr1'; }

    // === v1.10.0 GATE 1 — the MODERATION GATE (ban + community-rules consent).
    // Every community write gates on a CF-written `moderationGate/{uid}` doc
    // {banned:bool, consentVersion:int}:
    //   • notBanned    — no doc (a fresh user) OR banned != true.
    //   • hasConsented — doc EXISTS and consentVersion >= rulesVersion() (the
    //     literal below; bumping it re-prompts EVERYONE on their next write).
    //   • gateOk       — admin bypasses; everyone else must be not-banned AND
    //     consented. Appended to every content create/update + every vote
    //     create/update (NOT vote delete — unvote stays allowed while banned).
    //   • reportGateOk — admin OR not-banned (reporting stays consent-FREE so it
    //     is always frictionless; banned users cannot report).
    // Cost: Firestore caches get()/exists() on the SAME path within one rule
    // evaluation, so the repeated moderationGate reads bill as ~1 read per write
    // (the live forum-post rule already does a get(parent) per reply — same shape).
    // moderationGate is CF-ONLY written (gate 2: setBanState + acceptRules).
    function rulesVersion() { return 1; }   // CURRENT_RULES_VERSION — bump to re-prompt everyone
    function modGateExists() { return exists(/databases/$(database)/documents/moderationGate/$(request.auth.uid)); }
    function modGate() { return get(/databases/$(database)/documents/moderationGate/$(request.auth.uid)).data; }
    function notBanned() { return !modGateExists() || modGate().get('banned', false) != true; }
    function hasConsented() { return modGateExists() && modGate().get('consentVersion', 0) >= rulesVersion(); }
    function gateOk() { return isAdmin() || (notBanned() && hasConsented()); }
    function reportGateOk() { return isAdmin() || notBanned(); }

    // L2 — client-written timestamps must equal the server time (no backdating
    // to pin content, no future-dating). serverTimestamp() satisfies this.
    function createdNow() { return request.resource.data.createdAt == request.time; }
    // Vote docs: clients write only their own vote; the COUNT lives on the
    // parent and is Cloud-Function-owned (H1). M5: a 2s clamp on changing a
    // vote blunts toggle-spam at the source (toggle-OFF is a delete, unclamped).
    // L5: vote docs carry `uid == voterUid` so a departing user's votes scattered
    // under OTHER people's content are findable by a collectionGroup('votes')
    // sweep in onUserDelete (a CG query can't filter by leaf doc-id alone).
    // v1.10.0 gate 1: && gateOk() — a banned/un-consented user cannot cast or
    // change a vote (but CAN unvote — delete is ungated).
    function voteCreateOk(voterUid) {
      return isOwner(voterUid)
        && request.resource.data.value in [1, -1]
        && request.resource.data.uid == voterUid
        && request.resource.data.updatedAt == request.time
        && gateOk();
    }
    function voteUpdateOk(voterUid) {
      return isOwner(voterUid)
        && request.resource.data.value in [1, -1]
        && request.resource.data.uid == voterUid
        && request.resource.data.updatedAt == request.time
        && request.time > resource.data.updatedAt + duration.value(2, 's')
        && gateOk();
    }
    // === v1.10.0 GATES 12-14 — forum image attachments (forum surfaces ONLY).
    // imageRefs is an OPTIONAL list of ≤4 Storage paths, each pinned to the
    // CALLER's own uploads/{uid}/ prefix — a post can never point at someone
    // else's upload. Rules can't loop, so 4 slots check individually (a slot
    // index past the list's size passes vacuously).
    function imageRefSlotOk(i) {
      return request.resource.data.imageRefs.size() <= i
        || (request.resource.data.imageRefs[i] is string
            && request.resource.data.imageRefs[i].matches('uploads/' + request.auth.uid + '/[A-Za-z0-9_-]{1,100}/[A-Za-z0-9_-]{1,120}'));
    }
    function imageRefsOk() {
      return !('imageRefs' in request.resource.data)
        || (request.resource.data.imageRefs is list
            && request.resource.data.imageRefs.size() <= 4
            && imageRefSlotOk(0) && imageRefSlotOk(1) && imageRefSlotOk(2) && imageRefSlotOk(3));
    }
    // Admin moderation branch: the admin redacts image pointers as part of a
    // takedown. The atomic image-removal goes through the adminRemoveImage
    // CALLABLE (Admin SDK, bypasses these rules, binds imagePath→doc), so this
    // direct-write branch only ever needs to pass the SHAPE check (≤4, list) —
    // it is gated on isAdmin() (trusted operator), and entries belong to the
    // AUTHOR's prefix (not the admin's), so a per-slot own-prefix pin can't
    // apply here. Note: shape-only — it does NOT enforce subset-of-existing;
    // the trusted-admin gate is what bounds it.
    function imageRefsShapeOk() {
      return !('imageRefs' in request.resource.data)
        || (request.resource.data.imageRefs is list && request.resource.data.imageRefs.size() <= 4);
    }
    // Image overhaul — the thread's user-chosen card THUMBNAIL: one own-prefix
    // Storage path. Owner branches pin to the caller's prefix; the ADMIN branch
    // uses the shape-only variant (the merged doc carries the AUTHOR's path —
    // an admin pin/lock toggle must not trip on someone else's prefix).
    function thumbImageOk() {
      return !('thumbImage' in request.resource.data)
        || (request.resource.data.thumbImage is string
            && request.resource.data.thumbImage.matches('uploads/' + request.auth.uid + '/[A-Za-z0-9_-]{1,100}/[A-Za-z0-9_-]{1,120}'));
    }
    function thumbImageShapeOk() {
      return !('thumbImage' in request.resource.data)
        || (request.resource.data.thumbImage is string
            && request.resource.data.thumbImage.matches('uploads/[A-Za-z0-9_-]{1,128}/[A-Za-z0-9_-]{1,100}/[A-Za-z0-9_-]{1,120}'));
    }

    // Profile field validation (shared by create + update). M1 reserved-name
    // denylist; M2 photoURL constrained to known-good origins.
    function profileFieldsOk() {
      return request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && !(request.resource.data.displayName.lower() in ['blake', 'admin', 'administrator', 'moderator', 'mod', 'owner', 'staff'])
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 500))
        && (!('photoURL' in request.resource.data)
            || request.resource.data.photoURL == null
            || (request.resource.data.photoURL is string
                && request.resource.data.photoURL.matches('https://(firebasestorage[.]googleapis[.]com|lh3[.]googleusercontent[.]com)/.*')))
        && profileCustomFieldsOk();
    }
    // Dream-profile gate — the customization fields. All optional:
    //   • tags — self-tags rendered as purple chips. Rules can't loop a list,
    //     so only the COUNT is enforced here; per-entry length is clamped at
    //     render (escape-first + slice). A hostile long tag is display-inert.
    //   • accent — a CURATED enum, not free hex: an arbitrary color would let a
    //     profile dress itself gold (#ffd54a). The palette deliberately
    //     contains no gold/yellow — the heart stays Blake's by construction.
    //     Round 4: grew 6→16 (4 new solids + 6 g-* gradients) + optional
    //     accentGlow:bool (a glow toggle, not a color) — STILL no gold family.
    //   • frame — gate 20.5 (item 9b): a profile-card border theme. Same
    //     curated-enum shape as accent (12 user keys, no gold family), PLUS
    //     'blake' — Blake's EXCLUSIVE frame: valid only when the writer IS the
    //     ADMIN uid, so the exclusivity is enforced HERE, not hidden in the UI.
    //   • status — one short line under the name.
    //   • bgRef — the profile background: ONE Storage path pinned to the
    //     caller's own uploads/{uid}/profilebg/ prefix (same own-prefix pin as
    //     forum imageRefs; rides the full upload pipeline + moderation).
    //   • featuredAnime — the owner's pinned review: a communityKey (slug or
    //     al:<id>); the profile page fetches reviews/{key}/items/{ownUid}, so
    //     it can only ever surface the owner's OWN review.
    //   • likesCount is CF-owned (absent from the owner-writable key sets).
    function profileCustomFieldsOk() {
      return (!('tags' in request.resource.data)
            || (request.resource.data.tags is list && request.resource.data.tags.size() <= 6))
        && (!('accent' in request.resource.data)
            || request.resource.data.accent in ['violet', 'ember', 'teal', 'rose', 'sky', 'moss',
                                                'crimson', 'indigo', 'peach', 'pearl',
                                                'g-nebula', 'g-ember', 'g-ocean', 'g-meadow', 'g-dusk', 'g-sakura'])
        && (!('accentGlow' in request.resource.data)
            || request.resource.data.accentGlow is bool)
        && (!('frame' in request.resource.data)
            || request.resource.data.frame in ['vines', 'stone', 'cosmos', 'witch', 'clover', 'journey',
                                               'shadow', 'sakura', 'ember', 'tide', 'storm', 'moonlit']
            || (request.resource.data.frame == 'blake'
                && request.auth.uid == 'G2jGRa14u8bzGAmeBTkvXy8PKmr1'))
        && (!('status' in request.resource.data)
            || (request.resource.data.status is string && request.resource.data.status.size() <= 80))
        && (!('bgRef' in request.resource.data)
            || request.resource.data.bgRef == null
            || (request.resource.data.bgRef is string
                && request.resource.data.bgRef.matches('uploads/' + request.auth.uid + '/profilebg/[A-Za-z0-9_-]{1,120}')))
        && (!('featuredAnime' in request.resource.data)
            || request.resource.data.featuredAnime == null
            || (request.resource.data.featuredAnime is string
                && request.resource.data.featuredAnime.matches('[A-Za-z0-9:_-]{1,120}')));
    }

    // Personal-collection doc shape (round 4 — create + update; update sees the
    // MERGED doc, so the full shape re-validates on every write). items is a
    // list of ≤200 snapshot maps (animeId/title/coverImage/format/year, the
    // saved-row pattern) — rules can't iterate list entries, so only list+size
    // is enforced here; entries are escaped at render (display-inert).
    function collectionDocOk() {
      return request.resource.data.keys().hasOnly(['name', 'description', 'public', 'items', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        // description (gate 20) is OPTIONAL — shown under the shelf title.
        && (!('description' in request.resource.data)
            || (request.resource.data.description is string
                && request.resource.data.description.size() <= 200))
        && request.resource.data.public is bool
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 200
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    // =========================================================================
    // USER PROFILES + per-user lists  (PRIVATE per-user data — NOT gated; the
    // moderation gate is for COMMUNITY content, not a user's own saves/bell.)
    // =========================================================================
    match /users/{uid} {
      // gate 20.5 (2026-06-11): the planned owner-only GET tightening was
      // built and REVERTED in the same gate — the adversarial panel proved it
      // tombstones ACTIVE members ("a former member") whose identity lives
      // only in users/{uid} (profiles/ docs are minted ONLY by the account
      // Studio save; the index editor + pre-Studio accounts never made one).
      // The flip is BANKED behind a profiles backfill (dual-write or a
      // one-shot CF) — see docs/NEXT.md. Until then the public get stays: the
      // email-field exposure is the accepted, pre-existing trade.
      allow get: if true;
      allow list: if isOwner(uid);
      allow create, update, delete: if isOwner(uid);

      match /favorites/{animeId} {
        allow get, list, create, update, delete: if isOwner(uid);
      }
      match /watchlist/{animeId} {
        allow get, list, create, update, delete: if isOwner(uid);
      }

      // PERSONAL COLLECTIONS (round 4) — owner-curated anime shelves. Private
      // by default; `public: true` opens read-only access (get + a list that
      // MUST filter public==true — the public-profile shelf query; an
      // unfiltered foreign list stays denied). PUBLISHING is the community
      // surface, so it gates: a banned/un-consented user may keep PRIVATE
      // collections (watchlist parity) but cannot publish one. delete is
      // ungated — cleanup must always work (the unvote precedent). Admin may
      // read + delete for moderation (the day-1 mod-tool shape).
      match /collections/{colId} {
        allow get: if isOwner(uid) || resource.data.public == true || isAdmin();
        allow list: if isOwner(uid) || resource.data.public == true || isAdmin();
        allow create: if isOwner(uid) && collectionDocOk()
          && (request.resource.data.public != true || gateOk());
        allow update: if isOwner(uid) && collectionDocOk()
          && (request.resource.data.public != true || gateOk());
        allow delete: if isOwner(uid) || isAdmin();
      }

      // NOTIFICATIONS — H3: create is Cloud-Function-only (Admin SDK bypasses
      // rules). This closes the live spoof/spam vector (any signed-in user
      // could forge a "from Blake" ping into anyone's bell). Owner may only
      // mark-read and dismiss.
      match /notifications/{notifId} {
        allow get, list: if isOwner(uid);
        allow create: if false;
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow delete: if isOwner(uid);
      }
      // notifMeta / notifPrefs (added with the gate-6 notification rework).
      match /notifMeta/{docId} {
        allow get: if isOwner(uid);
        allow create, update, delete: if false; // CF-only (unread counter)
      }
      match /notifPrefs/{docId} {
        allow get, create, update, delete: if isOwner(uid); // owner controls mute/snooze
      }
    }

    // =========================================================================
    // Collection-group reads. `items` went PUBLIC at gate 16: the profile
    // pages list a member's reviews via a CG query, and every doc in an
    // `items` subcollection (comments + community reviews) is ALREADY
    // individually public via its own collection match — the CG widening
    // exposes nothing new, it only makes the cross-anime query legal.
    // Dream-profile gate: `threads`/`replies`/`posts` widen on the SAME
    // argument — every doc is already individually public in context (review
    // discussions, comment replies, forum posts); the activity-by-type feed
    // on public profiles needs the cross-context query. Tombstoned docs
    // (removed:true) are filtered at render. `votes` and DM collections are
    // NOT widened — those stay private.
    // =========================================================================
    match /{path=**}/items/{docId}   { allow get, list: if true; }
    match /{path=**}/threads/{docId} { allow get, list: if true; }
    match /{path=**}/replies/{docId} { allow get, list: if true; }
    match /{path=**}/posts/{docId}   { allow get, list: if true; }

    // =========================================================================
    // COMMENTS — `{anime}` is a catalog slug OR an `al:<aniListId>` per-season
    // key (the wildcard already accepts the colon; this is the per-season reuse,
    // no separate seasonComments collection). M3: create pins uid==auth.uid.
    // =========================================================================
    match /comments/{anime}/items/{cid} {
      allow get, list: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.displayName is string
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string || request.resource.data.photoURL == null)
        && createdNow()
        && request.resource.data.likesCount == 0
        && request.resource.data.dislikesCount == 0
        && (!('pinned' in request.resource.data) || request.resource.data.pinned == false)
        && (!exists(/databases/$(database)/documents/commentsMeta/$(anime))
            || get(/databases/$(database)/documents/commentsMeta/$(anime)).data.get('locked', false) != true)
        && imageRefsOk()   // image overhaul — comments carry ≤4 own-prefix images
        && gateOk();
      // owner may edit text only (H1: counts are CF-owned). Admins may also flip
      // the `pinned` flag (gate-4 mod tool) and nothing else.
      allow update: if (isSignedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'photoURL', 'displayName', 'imageRefs'])
          && imageRefsOk()
          && gateOk())
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned']));
      // owner OR admin (the day-1 mod tool) may delete.
      allow delete: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();

      match /votes/{voterUid} {
        allow get, list: if true;
        allow create: if voteCreateOk(voterUid);
        allow update: if voteUpdateOk(voterUid);
        allow delete: if isOwner(voterUid);
      }

      // NEW — depth-1 replies (a reply cannot itself be replied to).
      match /replies/{rid} {
        allow get, list: if true;
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.displayName is string
          && createdNow()
          && request.resource.data.likesCount == 0
          && request.resource.data.dislikesCount == 0
          && (!exists(/databases/$(database)/documents/commentsMeta/$(anime))
              || get(/databases/$(database)/documents/commentsMeta/$(anime)).data.get('locked', false) != true)
          && imageRefsOk()   // image overhaul
          && gateOk();
        allow update: if isSignedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'photoURL', 'displayName', 'imageRefs'])
          && imageRefsOk()
          && gateOk();
        allow delete: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
        match /votes/{voterUid} {
          allow get, list: if true;
          allow create: if voteCreateOk(voterUid);
          allow update: if voteUpdateOk(voterUid);
          allow delete: if isOwner(voterUid);
        }
      }
    }

    // =========================================================================
    // commentsMeta/{key} — admin thread-level controls (gate 4: a `locked` flag
    // that disables the composer for an anime's comments). Public read so the UI
    // reflects the lock; admin-only write.
    // =========================================================================
    match /commentsMeta/{key} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // COMMUNITY REVIEWS — one per user per anime (doc id == reviewer uid).
    // `{anime}` is a slug OR `al:<id>` per-season key (reuse, same as comments).
    // =========================================================================
    match /reviews/{anime}/items/{uid} {
      allow get, list: if true;
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string || request.resource.data.photoURL == null)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 5000
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 10
        && createdNow()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.likesCount == 0
        && request.resource.data.dislikesCount == 0
        && imageRefsOk()   // image overhaul — reviews carry ≤4 own-prefix images
        && thumbImageOk()  // mega-batch A4 — the dedicated review COVER
        && gateOk();
      // owner edits content only — H1: no count branch.
      allow update: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'rating', 'updatedAt', 'displayName', 'photoURL', 'imageRefs', 'thumbImage'])
        && imageRefsOk()
        && thumbImageOk()
        && gateOk();
      allow delete: if isOwner(uid) || isAdmin();

      match /votes/{voterUid} {
        allow get, list: if true;
        allow create: if voteCreateOk(voterUid);
        allow update: if voteUpdateOk(voterUid);
        allow delete: if isOwner(voterUid);
      }

      // existing reply subcollection on a community review (kept).
      match /threads/{tid} {
        allow get, list: if true;
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.displayName is string
          && createdNow()
          && request.resource.data.likesCount == 0
          && request.resource.data.dislikesCount == 0
          && gateOk();
        allow update: if isSignedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'photoURL', 'displayName'])
          && gateOk();
        allow delete: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
        match /votes/{voterUid} {
          allow get, list: if true;
          allow create: if voteCreateOk(voterUid);
          allow update: if voteUpdateOk(voterUid);
          allow delete: if isOwner(voterUid);
        }
      }
    }

    // =========================================================================
    // OFFICIAL (Blake) RATING VOTE TALLIES — L1: the aggregate counts become
    // Cloud-Function-owned (same rework as comment/review counts). Clients only
    // write their own vote doc.
    // =========================================================================
    match /official/{animeId} {
      allow get, list: if true;
      allow create, update, delete: if false; // CF-only aggregate
      match /votes/{voterUid} {
        allow get, list: if true;
        allow create: if voteCreateOk(voterUid);
        allow update: if voteUpdateOk(voterUid);
        allow delete: if isOwner(voterUid);
      }
    }

    // =========================================================================
    // COMMUNITY HUB — top-level `forum` (NOT `threads`, to avoid the existing
    // collection-group rule). H2: counters/mod-flags pinned at create; no
    // client branch writes a counter. H5: removing redacts the body/title.
    // Soft-delete is MONOTONIC: no owner branch ever sets removed=false (only the
    // admin branch may un-remove), so a banned user cannot resurrect content
    // during the gate-2 cascade window.
    // =========================================================================
    match /forum/{threadId} {
      allow get, list: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 4000
        && (request.resource.data.tag in ['general', 'recommend', 'blakes-44', 'offtopic', 'hottake', 'music', 'animation', 'episode', 'theories', 'news', 'manga', 'cosplay']
            || request.resource.data.tag.matches('anime:[a-z0-9-]{1,100}')
            || request.resource.data.tag.matches('anime:al:[0-9]{1,12}'))   // gate 6 anime:<slug> verdict-rail blend; gate 8c +hottake/music/animation; gate 8d +episode/theories/news/manga/cosplay topics + anime:al:<id> (non-44 AniList attach)
        && createdNow()
        && request.resource.data.lastPostAt == request.time
        && request.resource.data.postCount == 0
        && request.resource.data.reportCount == 0
        && (!('hotScore' in request.resource.data) || request.resource.data.hotScore == 0)
        && request.resource.data.pinned == false
        && request.resource.data.locked == false
        && request.resource.data.removed == false
        // gate 8d — optional attached-anime cover + title (validated: string + capped)
        && (!('coverImage' in request.resource.data) || (request.resource.data.coverImage is string && request.resource.data.coverImage.size() <= 400))
        && (!('animeTitle' in request.resource.data) || (request.resource.data.animeTitle is string && request.resource.data.animeTitle.size() <= 200))
        && imageRefsOk()   // gate 13 — ≤4 own-prefix Storage paths
        && thumbImageOk()  // overhaul item 8 — the user-chosen card thumbnail
        && gateOk();
      // owner edit (body + may attach/strip own images + re-pick the thumbnail)
      allow update: if ( isSignedIn() && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt', 'imageRefs', 'thumbImage'])
          && imageRefsOk()
          && thumbImageOk()
          && gateOk() )
        || // owner soft-delete (H5: must redact; may strip refs in the same write)
        ( isSignedIn() && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removed', 'body', 'title', 'editedAt', 'imageRefs', 'thumbImage'])
          && request.resource.data.removed == true
          && request.resource.data.body == '' && request.resource.data.title == ''
          && imageRefsOk()
          && thumbImageOk()
          && gateOk() )
        || // admin mod tools (pin / lock / remove / strip-image). H5: if removed, body+title redacted.
        ( isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'locked', 'removed', 'body', 'title', 'editedAt', 'imageRefs', 'thumbImage'])
          && imageRefsShapeOk()
          && thumbImageShapeOk()
          && (request.resource.data.removed == false || (request.resource.data.body == '' && request.resource.data.title == '')) );
      // counters (postCount/lastPostAt/reportCount/hotScore) have NO client
      // branch -> CF-only. delete is CF-only (soft-delete + cascade).
      allow delete: if false;

      match /posts/{postId} {
        allow get, list: if true;
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000
          && createdNow()
          && request.resource.data.likesCount == 0
          && request.resource.data.reportCount == 0
          && request.resource.data.removed == false
          // parent must exist and not be locked (one get() per reply — cheap vs abuse)
          && get(/databases/$(database)/documents/forum/$(threadId)).data.locked == false
          && imageRefsOk()   // gate 13 — ≤4 own-prefix Storage paths
          && gateOk();
        allow update: if ( isSignedIn() && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt', 'imageRefs'])
            && imageRefsOk()
            && gateOk() )
          || ( isSignedIn() && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removed', 'body', 'editedAt', 'imageRefs'])
            && request.resource.data.removed == true && request.resource.data.body == ''
            && imageRefsOk()
            && gateOk() )
          || ( isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removed', 'body', 'editedAt', 'blakePick', 'imageRefs'])
            && imageRefsShapeOk()
            && (request.resource.data.removed == false || request.resource.data.body == '') );   // gate 8c — admin-only "Blake's pick" gold marker (owner branches above CANNOT set it)
        allow delete: if false;
        match /votes/{voterUid} {
          allow get, list: if true;
          allow create: if voteCreateOk(voterUid);
          allow update: if voteUpdateOk(voterUid);
          allow delete: if isOwner(voterUid);
        }
      }
    }

    // =========================================================================
    // DIRECT MESSAGES — admin-floor only in v1.9.0 (one participant is always
    // ADMIN_UID, so there is no stranger-to-stranger surface). `kind:"peer"` is
    // BANKED: peer create is implicitly DENIED here (create requires
    // kind=="admin"); adding peer later is a CF-created path (study §3c), NOT a
    // client allow-branch. H4: reads are member-pinned and there is NO messages
    // collection-group rule. v1.10.0 gate 1: conversation create + the participant
    // summary update + message create are gated (banned/un-consented denied).
    // =========================================================================
    match /conversations/{convId} {
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.kind == 'admin'
        && (request.resource.data.participants[0] == 'G2jGRa14u8bzGAmeBTkvXy8PKmr1'
            || request.resource.data.participants[1] == 'G2jGRa14u8bzGAmeBTkvXy8PKmr1')
        && createdNow()
        && request.resource.data.state == 'open'
        && gateOk();
      // The conversation SUMMARY (lastMessageAt / lastSenderUid / unread_*) is
      // CF-OWNED (onDmMessageCreate, Admin SDK). The adversarial review showed
      // the old participant-writable summary branch let a member forge
      // lastMessageAt (sort/unread spoof) and write an unbounded lastMessageText
      // (contradicting the no-raw-preview design) — and NO client ever wrote it
      // (the client derives unread from reads/{uid} + treats the CF mirror as
      // untrusted). So the only client UPDATE is the admin LOCK toggle.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state']);
      allow delete: if false; // CF cascade (onUserDelete / admin)

      match /messages/{msgId} {
        allow get, list: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
          && get(/databases/$(database)/documents/conversations/$(convId)).data.state == 'open'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && createdNow()
          && gateOk();
        allow update, delete: if false; // immutable; moderation via state:"locked" / CF
      }

      match /reads/{rUid} {
        allow get: if isOwner(rUid);
        allow create, update: if isOwner(rUid)
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow delete: if false;
      }
    }

    // =========================================================================
    // PROFILES — public identity. M1: reserved-name denylist + isAdmin is the
    // only authority signal. M2: photoURL constrained to known-good origins.
    // isAdmin/isBanned are CF-only (absent from the owner-writable key set).
    // v1.10.0 gate 1: create + update gated (a banned user cannot establish or
    // change their public identity to evade).
    // =========================================================================
    match /profiles/{uid} {
      allow get, list: if true;
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'bio', 'joinedAt',
                                                 'tags', 'accent', 'accentGlow', 'frame', 'status', 'bgRef', 'featuredAnime'])
        && profileFieldsOk()
        && gateOk();
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'joinedAt',
                                                                             'tags', 'accent', 'accentGlow', 'frame', 'status', 'bgRef', 'featuredAnime'])
        && profileFieldsOk()
        && gateOk();
      allow delete: if false; // account deletion is the onUserDelete cascade CF

      // Dream-profile gate — PROFILE LIKES, the ONE sanctioned community
      // count (the heart carve-out): user-to-user social, never gold, no
      // leaderboard anywhere. Like-only (value must be 1 — there is no
      // dislike on a person), no self-like, vote-doc shape so the existing
      // CF machinery owns the count. Unlike (delete) stays ungated like
      // every other unvote. `get` is owner-of-the-like only (the client
      // needs "did I already like this?"); the public surface is ONLY the
      // CF-owned likesCount on the parent.
      match /likes/{likerUid} {
        allow get: if isOwner(likerUid);
        allow list: if false;
        // dream-profile HEART (adversarial MED): a like cannot land on BLAKE's
        // own profile — the carve-out count is community→community only; minting
        // it onto the one identity that must never carry a community count (even
        // though his name routes to the Den and the count is invisible on-site)
        // would still publish a likesCount on profiles/<ADMIN_UID> via raw read.
        allow create: if isOwner(likerUid)
          && likerUid != uid
          && uid != 'G2jGRa14u8bzGAmeBTkvXy8PKmr1'
          && request.resource.data.keys().hasOnly(['uid', 'value', 'updatedAt'])
          && request.resource.data.uid == likerUid
          && request.resource.data.value == 1
          && request.resource.data.updatedAt == request.time
          && gateOk();
        allow update: if false; // nothing to change — unlike is delete, re-like is create
        allow delete: if isOwner(likerUid);
      }
    }

    // =========================================================================
    // SUGGESTION COUNTS — CF-only writes. gate 20: single-doc GET is public
    // now (Blake's "👁 N requested" chip on the secondary modal — a demand
    // signal on the title's OWN page). LIST stays admin-only, which keeps the
    // original anti-brigading intent: no visitor can enumerate or rank the
    // request queue, they can only see the count where they already are.
    // =========================================================================
    match /suggestionCounts/{anilistId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // =========================================================================
    // REPORTS — moderation queue. Signed-in create (reporterUid pinned),
    // admin-only read/manage. L3: the queue re-fetches live public content;
    // snapshotText is treated as unverified. v1.10.0 gate 1: reportGateOk —
    // ban-gated (banned users cannot report) but NOT consent-gated (reporting
    // must always be frictionless, even for a user who hasn't read the rules).
    // =========================================================================
    match /reports/{reportId} {
      allow get, list, update, delete: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['reporterUid', 'reason', 'note', 'status', 'targetType', 'targetPath', 'targetUid', 'targetAnimeId', 'snapshotText', 'imagePath', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in ['spam', 'harassment', 'offtopic', 'other']
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        && request.resource.data.status == 'new'
        // gate 14 — 'image': targetPath = the forum doc holding the pointer,
        // imagePath = the uploads/... Storage object (shape-pinned below).
        // dream-profile gate — 'profile': targetPath = profiles/{uid}; covers
        // bio/tags/status/avatar/background in one report (the admin View
        // opens the live profile; the bg object rides imagePath if reported).
        && request.resource.data.targetType in ['review', 'comment', 'reply', 'thread', 'forum', 'post', 'dm', 'image', 'profile']
        && request.resource.data.targetPath is string
        && (!('imagePath' in request.resource.data)
            || (request.resource.data.imagePath is string
                && request.resource.data.imagePath.matches('uploads/[A-Za-z0-9_-]{1,128}/[A-Za-z0-9_-]{1,100}/[A-Za-z0-9_-]{1,120}')))
        && (!('snapshotText' in request.resource.data) || (request.resource.data.snapshotText is string && request.resource.data.snapshotText.size() <= 500))
        && createdNow()
        && reportGateOk();
    }

    // =========================================================================
    // SUGGESTIONS (existing) — public create + ADMIN-only manage. NOT gated:
    // anime requests are allowed anonymously (no uid to gate), and a request to
    // Blake is not community content. Q2: an OPTIONAL signed-in `submitterUid`
    // enables the suggestion-reply channel.
    // =========================================================================
    match /suggestions/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['title', 'reason', 'submittedAt', 'status',
                                                             'anilistId', 'coverImage', 'format', 'year',
                                                             'englishTitle', 'romajiTitle', 'submitterUid'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 200
        && (!('reason' in request.resource.data)
            || (request.resource.data.reason is string && request.resource.data.reason.size() < 1000))
        && request.resource.data.status == 'new'
        && ('submittedAt' in request.resource.data)
        // Q2: optional submitter uid; if present, must be the caller's own uid.
        && (!('submitterUid' in request.resource.data)
            || (request.resource.data.submitterUid is string
                && isSignedIn()
                && request.resource.data.submitterUid == request.auth.uid))
        && (!('anilistId' in request.resource.data)
            || (request.resource.data.anilistId is int && request.resource.data.anilistId > 0))
        && (!('coverImage' in request.resource.data)
            || (request.resource.data.coverImage is string && request.resource.data.coverImage.size() < 500))
        && (!('format' in request.resource.data)
            || (request.resource.data.format is string && request.resource.data.format.size() < 20))
        && (!('year' in request.resource.data)
            || (request.resource.data.year is int && request.resource.data.year > 1900 && request.resource.data.year < 2100))
        && (!('englishTitle' in request.resource.data)
            || (request.resource.data.englishTitle is string && request.resource.data.englishTitle.size() < 200))
        && (!('romajiTitle' in request.resource.data)
            || (request.resource.data.romajiTitle is string && request.resource.data.romajiTitle.size() < 200));
      allow get, list, update, delete: if isAdmin();
    }

    // =========================================================================
    // moderationGate / banned / rulesConsent — the gate-1 moderation spine docs.
    // ALL CF-ONLY WRITE (set by the gate-2 setBanState + acceptRules callables via
    // the Admin SDK, which bypasses rules). moderationGate is the rules-truth the
    // gate() reads; banned is the audit + cascade trigger; rulesConsent is the
    // consent record. Owner may READ their own gate/consent (to drive the UI).
    // =========================================================================
    match /moderationGate/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list, create, update, delete: if false;
    }
    match /banned/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list, create, update, delete: if false;
    }
    match /rulesConsent/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list, create, update, delete: if false;
    }

    // =========================================================================
    // uploadHashes/{uid__hash} — the image-dedupe registry (image overhaul).
    // CF-ONLY write (processUploadedImage maintains it). The OWNER may read
    // their own entry so the picker can say "you've already uploaded this
    // exact image" BEFORE burning an upload; list stays denied (no probing
    // other users' hashes — a hash oracle would leak who uploaded what).
    // =========================================================================
    match /uploadHashes/{id} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list, create, update, delete: if false;
    }
  }
}
